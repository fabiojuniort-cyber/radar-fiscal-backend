{
  "name": "radar-fiscal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/infrastructure/database/migrate.js",
    "db:types": "kysely-codegen --dialect postgres --default-schema=public --out-file src/infrastructure/database/database.types.ts",
    "db:provision-runtime-role": "node dist/infrastructure/database/provision-runtime-role.js",
    "db:prepare": "npm run db:migrate && npm run db:provision-runtime-role && npm run db:verify-runtime",
    "db:verify-runtime": "node dist/infrastructure/database/verify-runtime-role.js",
    "test": "tsx --test test/auth.unit.test.ts test/collection.executor.unit.test.ts test/collection.retry.unit.test.ts test/collection.run-status.unit.test.ts test/collection.normalizer.unit.test.ts",
    "test:integration": "tsx --test test/auth.integration.test.ts",
    "test:collection-integration": "tsx --test test/collection.persistence.integration.test.ts test/collection.run-lifecycle.integration.test.ts test/collection.scenarios.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}

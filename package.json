{
  "name": "radar-fiscal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/infrastructure/database/migrate.js",
    "db:types": "kysely-codegen --dialect postgres --env-file .env --default-schema=public --out-file src/infrastructure/database/database.types.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

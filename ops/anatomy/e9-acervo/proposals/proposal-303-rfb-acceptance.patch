+  assert.equal(acc([rec(148693, { engineBuildHash: '0'.repeat(64) })], 148693), false, 'another engine voids it');
+  assert.equal(acc([rec(148693, { sampleId: 'rfb:142967' })], 148693), false, 'a record for another sample never counts');

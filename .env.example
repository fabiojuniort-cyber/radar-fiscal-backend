NODE_ENV=development

HOST=0.0.0.0
PORT=3000

LOG_LEVEL=info

DATABASE_URL=postgresql://radar_app_runtime:change-me@localhost:5432/radar_fiscal
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/radar_fiscal
DB_RUNTIME_PASSWORD=change-me-with-at-least-32-characters
DB_WORKER_RUNTIME_PASSWORD=change-me-with-at-least-32-characters

JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
AUTH_REFRESH_COOKIE_NAME=radar_refresh_token

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

COLLECTION_WORKER_ID=local-worker-1
COLLECTION_POLL_INTERVAL_MS=1000
COLLECTION_TIMEOUT_MS=30000
COLLECTION_HEARTBEAT_INTERVAL_MS=15000
COLLECTION_STALE_AFTER_MS=120000
SCHEDULER_POLL_INTERVAL_MS=30000
COLLECTION_ENABLE_SIMULATED_CONNECTORS=false

# Optional source-specific CONFAZ egress experiments.
# Do not configure proxy and relay simultaneously in normal operation.
# CONFAZ_PROXY_URL=http://user:password@proxy.example:8080
# CONFAZ_RELAY_URL=https://relay.example.test
# CONFAZ_RELAY_TOKEN=change-me-with-at-least-24-characters
